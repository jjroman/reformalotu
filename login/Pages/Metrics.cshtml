@page
@model login.Pages.MetricsModel
@{
    ViewData["Title"] = "Resumen";
}

<div class="product-page metrics-page">
    <header class="product-page-heading">
        <div>
            <span class="product-eyebrow">ACTIVIDAD</span>
            <h1>Resumen</h1>
            <p>Actividad acumulada de proyectos y vídeos en la plataforma.</p>
        </div>
    </header>
    <dl class="metrics-grid">
        <div class="metric-item">
            <dt>Proyectos creados</dt>
            <dd>@Model.ProjectCount</dd>
            <span>Ideas guardadas</span>
        </div>
        <div class="metric-item">
            <dt>Aperturas de vídeos</dt>
            <dd>@Model.VideoOpenCount</dd>
            <span>Visitas a recomendaciones</span>
        </div>
    </dl>
</div>
