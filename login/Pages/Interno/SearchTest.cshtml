@page "/interno/prueba-busqueda"
@model login.Pages.Interno.SearchTestModel
@{
    ViewData["Title"] = "Prueba de búsqueda";
}

<div class="product-page catalog-page">
    <header class="product-page-heading">
        <div>
            <span class="product-eyebrow">INTERNO</span>
            <h1>Prueba de búsqueda</h1>
            <p>Compara la búsqueda semántica con la actual. No guarda proyectos ni recomendaciones.</p>
        </div>
    </header>

    <form method="get" class="project-form catalog-filters">
        <div class="mb-3">
            <label for="q" class="form-label">Consulta</label>
            <input id="q" name="q" type="search" class="form-control" value="@Model.Q" maxlength="500" autocomplete="off" />
        </div>
        <div class="form-check mb-3">
            <input id="semantic" name="semantic" type="checkbox" value="true" class="form-check-input" checked="@Model.Semantic" />
            <label for="semantic" class="form-check-label">Búsqueda semántica</label>
        </div>
        <div class="mb-3">
            <label for="threshold" class="form-label">Umbral de similitud (solo semántica)</label>
            <input id="threshold" name="threshold" type="number" step="0.01" min="-1" max="1" class="form-control"
                   value="@Model.Threshold?.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                   placeholder="@Model.DefaultThreshold.ToString(System.Globalization.CultureInfo.InvariantCulture)" aria-describedby="threshold-help" />
            <div id="threshold-help" class="form-text">Vacío usa el valor configurado. Sirve para calibrarlo con consultas reales.</div>
        </div>
        <div class="project-form-actions">
            <button type="submit" class="btn btn-primary">Buscar</button>
            <a class="btn btn-outline-secondary" asp-page="./SearchTest">Limpiar</a>
        </div>
    </form>

    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    @if (Model.Searched && Model.ErrorMessage is null)
    {
        <section class="project-results" aria-labelledby="search-results">
            <div class="project-section-heading">
                <h2 id="search-results">Resultados (@(Model.Semantic ? "semántica" : "actual"))</h2>
                <span class="project-results-count">@Model.Results.Count</span>
            </div>
            @if (Model.Results.Count == 0)
            {
                <div class="project-inline-empty">
                    <p>No hay resultados adecuados.</p>
                    @if (Model.Semantic && Model.BestSimilarity is { } best)
                    {
                        <p>Mejor similitud encontrada: @best.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture)</p>
                    }
                </div>
            }
            else
            {
                <div class="project-video-list">
                    @foreach (var result in Model.Results)
                    {
                        var title = string.IsNullOrWhiteSpace(result.Title) ? result.VideoId : result.Title;
                        <article class="project-video-item">
                            <img src="https://img.youtube.com/vi/@result.VideoId/hqdefault.jpg" alt="Miniatura del vídeo @title" loading="lazy" />
                            <div class="project-video-copy">
                                <h3>@title</h3>
                                <p><strong>@(Model.Semantic ? "Similitud" : "Puntuación"):</strong> @result.Score</p>
                                <p>@result.Summary</p>
                                <a href="https://www.youtube.com/watch?v=@Uri.EscapeDataString(result.VideoId)" target="_blank" rel="noopener noreferrer">Ver en YouTube</a>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    }
</div>
