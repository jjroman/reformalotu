@page
@model login.Pages.Projects.IndexModel
@{
    ViewData["Title"] = "Mis proyectos";
}

<h1>Mis proyectos</h1>

@if (Model.Projects.Count == 0)
{
    <p>Aún no tienes proyectos guardados.</p>
    <a class="btn btn-primary" asp-page="./Create">Crear proyecto</a>
}
else
{
    <p><a class="btn btn-primary" asp-page="./Create">Crear proyecto</a></p>
    <div class="list-group">
        @foreach (var project in Model.Projects)
        {
            <a class="list-group-item list-group-item-action" asp-page="./Details" asp-route-id="@project.Id">
                <strong>@project.Description</strong>
                <span class="d-block text-muted">@project.CreatedAt.ToLocalTime().ToString("g")</span>
                @if (!string.IsNullOrWhiteSpace(project.Category))
                {
                    <span class="badge text-bg-secondary">@project.Category</span>
                }
            </a>
        }
    </div>
}
