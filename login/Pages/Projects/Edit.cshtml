@page "{id:guid}"
@model login.Pages.Projects.EditModel
@{
    ViewData["Title"] = "Editar proyecto";
}

<div class="product-page project-form-page">
    <header class="product-page-heading">
        <div>
            <span class="product-eyebrow">AJUSTA TU IDEA</span>
            <h1>Editar proyecto</h1>
            <p>Actualiza el nombre, la descripción o la categoría de tu proyecto.</p>
        </div>
    </header>
    <form method="post" class="project-form">
        <div asp-validation-summary="ModelOnly" class="text-danger validation-summary"></div>
        <div class="mb-3">
            <label asp-for="Input.Name" class="form-label">Nombre del proyecto</label>
            <input asp-for="Input.Name" class="form-control" maxlength="200" autocomplete="off" />
            <span asp-validation-for="Input.Name" class="text-danger"></span>
            <div class="form-text">Hasta 200 caracteres.</div>
        </div>
        <div class="mb-3">
            <label asp-for="Input.Description" class="form-label">Descripción</label>
            <textarea asp-for="Input.Description" class="form-control" rows="6" maxlength="1000" data-markdown-editor></textarea>
            <span asp-validation-for="Input.Description" class="text-danger"></span>
            <div class="form-text">Puedes usar Markdown; la barra de formato te ayuda a empezar.</div>
        </div>
        <div class="mb-4">
            <label asp-for="Input.Category" class="form-label">Categoría <span class="form-label-optional">(opcional)</span></label>
            <select asp-for="Input.Category" class="form-select">
                <option value="">Sin categoría</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Name">@category.Name</option>
                }
            </select>
            <span asp-validation-for="Input.Category" class="text-danger"></span>
        </div>
        <div class="project-form-actions">
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a asp-page="./Details" asp-route-id="@RouteData.Values["id"]" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
